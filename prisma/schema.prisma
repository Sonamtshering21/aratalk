// AraTalk database schema (Prisma 6, classic generator).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id           String    @id @default(cuid())
  title        String    @db.VarChar(120)
  body         String    @db.Text
  nickname     String    @db.VarChar(60)
  /// sha256(cookie uuid + IDENTITY_SECRET). Never select this for the client.
  authorHash   String    @db.Char(64)
  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  reportCount  Int       @default(0)
  hidden       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  comments     Comment[]
  likes        Like[]

  @@index([hidden, createdAt])
  @@index([authorHash, createdAt])
}

model Comment {
  id          String        @id @default(cuid())
  postId      String
  /// Top-level comment this replies to. Replies are one level deep only.
  parentId    String?
  body        String        @db.Text
  nickname    String        @db.VarChar(60)
  authorHash  String        @db.Char(64)
  likeCount   Int           @default(0)
  reportCount Int           @default(0)
  hidden      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("CommentReplies")
  likes       CommentLike[]

  @@index([postId, hidden, createdAt])
  @@index([parentId])
}

model CommentLike {
  commentId String
  userHash  String   @db.Char(64)
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, userHash])
  @@index([userHash])
}

model Like {
  postId    String
  userHash  String   @db.Char(64)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, userHash])
  @@index([userHash])
}

enum ReportTarget {
  POST
  COMMENT
}

model Report {
  id         String       @id @default(cuid())
  targetType ReportTarget
  targetId   String
  userHash   String       @db.Char(64)
  reason     String?      @db.VarChar(200)
  createdAt  DateTime     @default(now())

  @@unique([targetType, targetId, userHash])
  @@index([targetType, targetId])
}
