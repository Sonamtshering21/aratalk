# Copy to .env and fill in. Never commit real values.

# Postgres connection used by the app.
# Neon: the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aratalk?sslmode=require"

# Direct (non-pooled) connection, used by `prisma migrate`.
# Neon: the direct connection string. Locally it can reuse DATABASE_URL:
#   DIRECT_URL="${DATABASE_URL}"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/aratalk?sslmode=require"

# Optional: connections per server instance (default 5). Ignored if
# DATABASE_URL already sets connection_limit.
# DATABASE_POOL_SIZE=5

# Long random secret that salts anonymous identity hashes (32+ characters).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later gives every visitor a new identity and nickname.
IDENTITY_SECRET=""

# Optional, seed only: extra filler posts for trying infinite scroll.
# SEED_EXTRA_POSTS=60
